+ResourceUID::ID ResourceUID::get_id_for_path(const String &p_path) const {
+	MutexLock l(mutex);
+	ID match = INVALID_ID;
+	for (const KeyValue<ID, Cache> &entry : unique_ids) {
+		if (String::utf8(entry.value.cs.ptr()) == p_path) {
+			if (match != INVALID_ID) {
+				return INVALID_ID;
+			}
+			match = entry.key;
+		}
+	}
+	return match;
+}
